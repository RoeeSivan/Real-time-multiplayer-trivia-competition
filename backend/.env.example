# Backend env — copy to backend/.env and fill in.

# OpenAI for Call-a-Friend (graceful canned fallback if missing).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# CORS allowlist for the frontend origin. Comma-separated, no trailing slash.
# Leave UNSET for local LAN dev (defaults to "*"). Set for tunnel/prod:
#   FRONTEND_URL=https://<random>.ngrok-free.app
# `./run.sh --tunnel` writes this automatically after ngrok comes up.
# FRONTEND_URL=

# ngrok (only needed for `./run.sh --tunnel`).
# Get authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# Reserve 1 free static domain at https://dashboard.ngrok.com/domains
# NGROK_AUTHTOKEN=
# NGROK_BACKEND_DOMAIN=trivia-be.ngrok-free.app
